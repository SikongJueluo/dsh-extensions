{
  "name": "dsh-oauth-providers",
  "version": "0.6.0",
  "description": "DSH LLM adapter plugins for OAuth-authenticated providers: ChatGPT subscription today, one provider module per vendor — built-in pi-style sign-in (browser link + paste fallback), no API keys",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY-NOTICE.md"
  ],
  "scripts": {
    "build": "tsdown && vite build --config vite.client.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "clean": "rm -rf lib",
    "prepare": "tsdown && vite build --config vite.client.config.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-authorization": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dependencies": {
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-attachment": "catalog:",
    "@deepseek-ai/dsh-authorization": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-credentials": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@dsh-extensions/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
