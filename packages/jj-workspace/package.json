{
  "name": "dsh-jj-workspace",
  "version": "0.1.0",
  "description": "DSH jj-workspace plugin: makes the existing create_worktree tool and new-session worktree option create isolated Jujutsu workspaces with a same-name task bookmark in jj repositories, while Git-only repositories keep the stock Git worktree behavior",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dev.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && vite build --config vite.client.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "clean": "rm -rf lib",
    "prepare": "tsdown && vite build --config vite.client.config.ts",
    "smoke": "node smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-experimental-client-ui-forge"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-experimental-worktree": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-fs": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-timeout": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-working-directory": "^0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-experimental-worktree": "catalog:",
    "@deepseek-ai/dsh-fs": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:",
    "@deepseek-ai/dsh-sandbox": "catalog:",
    "@deepseek-ai/dsh-sandbox-policy": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-subprocess": "catalog:",
    "@deepseek-ai/dsh-timeout": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-working-directory": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@dsh-extensions/ui": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-test-renderer": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "^3.2.4"
  }
}
