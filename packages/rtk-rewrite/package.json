{
  "name": "dsh-rtk-rewrite",
  "version": "0.2.0",
  "description": "DSH rtk-rewrite plugin: sandboxed bash executor that rewrites supported commands to their rtk equivalents before execution (host-side `rtk rewrite` query; stdout decides) on top of dsh-auto-env's direnv overlay",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "prepare": "tsdown",
    "smoke": "node smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-bash-sandbox": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "dsh-auto-env": "^0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-bash-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.2",
    "@deepseek-ai/dsh-shell-env": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "dsh-auto-env": "workspace:*"
  }
}
