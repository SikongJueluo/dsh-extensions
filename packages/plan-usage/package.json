{
  "name": "dsh-plan-usage",
  "version": "0.2.0",
  "description": "DSH plan-usage plugin: a planUsage host service aggregating coding-plan quota windows (GLM 5h/weekly via z.ai/bigmodel, OpenAI Codex via ChatGPT OAuth, MiniMax Token Plan, OpenCode Go via zen/go/v1/usage + OPENCODE_API_KEY) plus a Settings section with bars and reset countdowns; shows only routes the process actually registers",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dev.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && vite build --config vite.client.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "clean": "rm -rf lib",
    "prepare": "tsdown && vite build --config vite.client.config.ts",
    "smoke": "node smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@dsh-extensions/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
