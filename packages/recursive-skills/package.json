{
  "name": "dsh-recursive-skills",
  "version": "0.1.0",
  "description": "DSH recursive-skills plugin: a supplemental skill provider that discovers SKILL.md bundles nested under category directories beneath the shared agents skill root, so the native catalog loads them on demand like direct skills",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "dev.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf lib",
    "prepare": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-fs": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": "^0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-fs": "catalog:",
    "@deepseek-ai/dsh-fs-local": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-skill": "catalog:",
    "@deepseek-ai/dsh-skill-filesystem": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "vitest": "^3.2.4"
  }
}
