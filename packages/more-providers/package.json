{
  "name": "dsh-more-providers",
  "version": "0.1.0",
  "description": "Env-driven extra LLM providers for DSH: Command Code subscription (CMD_API_KEY) today, with its live model catalog mapped across anthropic-messages, openai-responses and openai-completions",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dev.patch.yml",
    "README.md",
    "example.yaml"
  ],
  "scripts": {
    "build": "tsdown && vite build --config vite.client.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "smoke": "node smoke.mjs",
    "clean": "rm -rf lib",
    "prepare": "tsdown && vite build --config vite.client.config.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-llm-pi-ai": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@earendil-works/pi-ai": "1.5.0",
    "@dsh-extensions/config": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@dsh-extensions/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:"
  }
}
