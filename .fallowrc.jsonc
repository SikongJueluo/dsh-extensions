{
  "$schema": "./node_modules/fallow/schema.json",
  "ignorePatterns": ["repo/**"],
  "ignoreBinaries": ["jj"],

  "supportEntry": [
    "packages/*/smoke.mjs",
    "packages/*/scripts/smoke-*.mjs",
    "packages/*/live-check.mjs",
  ],
  "usedClassMembers": [
    { "extends": "Service", "members": ["*"] },
    { "extends": "SandboxPolicyService", "members": ["*"] },
  ],
}
