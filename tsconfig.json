{
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "scripts",
    "tooling",

    ".storybook/main.ts",
    ".storybook/preview.tsx",
    "packages/*/*.config.ts",
    "packages/*/test"
  ],
  "exclude": ["node_modules", "storybook-static", "repo", ".tmp"]
}
