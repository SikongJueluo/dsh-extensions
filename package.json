{
  "name": "dsh-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Out-of-tree DeepSeek Harness plugin bundles",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fallow": "fallow dead-code",
    "fallow:health": "fallow health",
    "fallow:dupes": "fallow dupes",
    "check:client": "node scripts/check-client.mjs",
    "check:smoke": "node scripts/check-smoke.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run check:client",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "clean": "pnpm -r run clean",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "fallow": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
