{
  "name": "dsh-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Out-of-tree DeepSeek Harness plugin bundles",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check:client": "node scripts/check-client.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run check:client",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "clean": "pnpm -r run clean",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
